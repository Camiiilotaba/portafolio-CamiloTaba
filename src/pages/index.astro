---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Home from "../components/Home.astro";
import Projects from "../components/Projects.astro";
import Experience from "../components/Experience.astro";
import HowIWork from "../components/HowIWork.astro";
import ContactForm from "../components/ContactForm.astro";
import { t } from "../i18n/utils";
import type { Lang } from "../i18n/utils";

const lang: Lang = 'en';
---

<Layout lang={lang}>
  <Header lang={lang} />

  <main class="text-white">
    <section
      id="home"
      class="bg-gradient-to-b from-black via-emerald-950 to-black py-8 w-full pb-10 lg:pb-0"
      aria-label={t(lang, 'home.aria_section')}
    >
      <Home lang={lang} />
    </section>

    <section
      id="projects"
      class="bg-gradient-to-b from-black via-emerald-950 to-black"
      aria-label={t(lang, 'projects.aria_section')}
    >
      <Projects lang={lang} />
    </section>

    <section
      id="experience"
      class="bg-gradient-to-b from-black via-emerald-950 to-black py-20 overflow-hidden"
      aria-label={t(lang, 'experience.aria_section')}
    >
      <Experience lang={lang} />
    </section>

    <section
      id="about"
      class="bg-gradient-to-b from-black via-emerald-950 to-black py-20 w-full px-4 pt-10 lg:pt-12 2xl:pt-30"
      aria-label={t(lang, 'howIWork.aria_section')}
    >
      <HowIWork lang={lang} />
    </section>

    <section
      id="contact"
      class="bg-gradient-to-b from-black via-emerald-950 to-black py-20 w-full px-4 pt-10 lg:pt-12 2xl:pt-30"
    >
      <ContactForm lang={lang} />
    </section>
  </main>

  <Footer lang={lang} />
</Layout>
