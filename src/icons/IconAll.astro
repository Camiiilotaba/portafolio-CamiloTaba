---
import IconTailwind from "./IconTailwind.astro";
import IconTypeScript from "./IconTypeScript.astro";
import IconReact from "./IconReact.astro";
import IconJavaScript from "./IconJavaScript.astro";
import IconVite from "./IconVite.astro";
import IconLaravel from "./IconLaravel.astro";
import IconPhp from "./IconPhp.astro";
import IconMysql from "./IconMysql.astro";
import IconWebsocket from "./IconWebsocket.astro";
import IconVue from "./IconVue.astro";
import IconFlutter from "./IconFlutter.astro";
import IconFirebase from "./IconFirebase.astro";

export const ICONS = {
  javaScript: IconJavaScript,
  react: IconReact,
  tailwind: IconTailwind,
  typeScript: IconTypeScript,
  vite: IconVite,
  laravel: IconLaravel,
  php: IconPhp,
  mysql: IconMysql,
  websocket: IconWebsocket,
  vue: IconVue,
  flutter: IconFlutter,
  firebase: IconFirebase,
};

export function getIconComponent(iconName: string) {
  return ICONS[iconName] || null;
}
---
