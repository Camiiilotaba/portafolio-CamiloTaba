---
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Home from "./Home.astro";
import Projects from "./Projects.astro";
import Expertise from "./Expertise.astro";
import Experience from "./Experience.astro";
import ContactForm from "./ContactForm.astro";
import { t } from "../i18n/utils";
import type { Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Layout lang={lang}>
  <Header lang={lang} />

  <main id="main">
    <section id="home" aria-label={t(lang, 'home.aria_section')}>
      <Home lang={lang} />
    </section>

    <section id="projects" class="border-t border-line" aria-label={t(lang, 'projects.aria_section')}>
      <Projects lang={lang} />
    </section>

    <section id="expertise" class="border-t border-line" aria-label={t(lang, 'expertise.aria_section')}>
      <Expertise lang={lang} />
    </section>

    <section id="experience" class="border-t border-line" aria-label={t(lang, 'experience.aria_section')}>
      <Experience lang={lang} />
    </section>

    <section id="contact" class="border-t border-line" aria-label={t(lang, 'contact.aria_section')}>
      <ContactForm lang={lang} />
    </section>
  </main>

  <Footer lang={lang} />
</Layout>
