---
import HeaderLink from "../HeaderLink.astro";
---

<header class="bg-black shadow ">
  <div
    class="container mx-auto px-2 lg:px-0 py-4 flex justify-between items-center"
  >
    <!-- Logo -->
    <div class="flex items-center">
      <img src="/img/logooo.png" alt="Logo" class="h-20 w-25 object-contain" />
      <span class="ml-2 text-lg font-semibold text-white"></span>
    </div>
    
     
    <div class="flex items-center space-x-4">
      <!-- Selector de idioma -->
    
<form class="max-w-sm mx-auto">
  <label for="underline_select" class="sr-only">Underline select</label>
  <select id="language-select" class="block py-2.5 px-0 w-full text-sm text-gray-100 bg-black border-0  appearance-none dark:text-gray-400 dark:border-gray-700 focus:outline-none focus:ring-0 focus:border-gray-200 peer">
      <option selected>English 🇬🇧</option>
      <option value="">Spanish 🇪🇸</option>
      
  </select>
</form>


      <!-- Botón de modo oscuro/claro -->
      <button
        id="theme-toggle"
        class="bg-transparent text-white font-bold uppercase text-sm md:text-base tracking-wide rounded-md px-6 py-4 shadow-lg transition-all duration-300 ease-in-out hover:bg-blue-800 hover:shadow-2xl hover:-translate-y-2 xl:hidden 2xl:hidden"
      >
        🌙
      </button>
    </div>
  </div>
</header>

<!-- Botón de modo oscuro/claro para pantallas grandes (xl y 2xl) -->
<button
  id="theme-toggle-xl"
  class="hidden xl:block 2xl:block xl:fixed 2xl:fixed xl:bottom-10 2xl:bottom-10 xl:right-10 2xl:right-10 bg-transparent text-white font-bold uppercase text-sm md:text-base tracking-wide rounded-md px-6 py-4 shadow-lg transition-all duration-300 ease-in-out hover:bg-blue-800 hover:shadow-2xl hover:-translate-y-2"
>
  🌙
</button>


<!-- Cargar scripts externos -->
<script>
  import "../../scripts/menuToggle.ts";
  import "../../scripts/toggleTheme.js";
  import "../../scripts/changeLanguage.js";
</script>
