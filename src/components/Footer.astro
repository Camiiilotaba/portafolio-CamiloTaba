---
import type { Lang } from "../i18n/utils";
import { t, getLocalePath } from "../i18n/utils";
import { GITHUB_URL, LINKEDIN_URL, EMAIL, GITHUB_ICON_PATH, LINKEDIN_ICON_PATH, EMAIL_ICON_PATH } from "../data/socials";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const today = new Date();

const navLinks = [
  { href: '#home', key: 'nav.home' },
  { href: '#projects', key: 'nav.projects' },
  { href: '#experience', key: 'nav.experience' },
  { href: '#contact', key: 'nav.contact' },
];

const socials = [
  { href: GITHUB_URL, label: 'GitHub', aria: 'footer.aria_github', path: GITHUB_ICON_PATH },
  { href: LINKEDIN_URL, label: 'LinkedIn', aria: 'footer.aria_linkedin', path: LINKEDIN_ICON_PATH },
];
---

<footer class="relative pt-14 pb-8 overflow-hidden">
  <div
    class="absolute top-0 left-0 right-0 h-px"
    style="background: linear-gradient(90deg, transparent, rgba(16,185,129,0.6), transparent);"
    aria-hidden="true"
  ></div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-8">

      <div class="md:col-span-5 space-y-4">
        <a
          href={getLocalePath(lang)}
          class="inline-block text-2xl font-bold text-white hover:text-green-400 transition-colors"
          style="font-family: var(--font-heading);"
        >
          Camilo Taba
        </a>
        <p class="text-sm text-gray-400 leading-relaxed max-w-sm">
          {t(lang, 'footer.tagline')}
        </p>

        <p class="flex items-center gap-2 text-xs text-gray-500">
          <svg class="w-3.5 h-3.5 text-emerald-500/70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          {t(lang, 'footer.location')}
        </p>
      </div>

      <nav class="md:col-span-3" aria-label={t(lang, 'footer.nav_heading')}>
        <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-gray-500 mb-4">
          {t(lang, 'footer.nav_heading')}
        </h2>
        <ul class="space-y-2.5">
          {navLinks.map(({ href, key }) => (
            <li>
              <a
                href={href}
                class="group inline-flex items-center gap-2 text-sm text-gray-400 hover:text-emerald-300 transition-colors"
              >
                <span class="h-px w-0 bg-emerald-400 transition-all duration-300 group-hover:w-4" aria-hidden="true"></span>
                {t(lang, key)}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="md:col-span-4">
        <h2 class="text-xs font-mono uppercase tracking-[0.2em] text-gray-500 mb-4">
          {t(lang, 'footer.connect_heading')}
        </h2>
        <div class="space-y-2.5">
          {socials.map(({ href, label, aria, path }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-3 text-gray-400 hover:text-emerald-300 transition-colors"
              aria-label={t(lang, aria)}
            >
              <span class="flex items-center justify-center w-9 h-9 rounded-lg border border-white/10 bg-white/[0.03] group-hover:border-emerald-500/40 group-hover:bg-emerald-500/[0.08] transition-colors">
                <svg viewBox="0 0 16 16" fill="currentColor" width="18" height="18" aria-hidden="true">
                  <path d={path} />
                </svg>
              </span>
              <span class="text-sm font-medium">{label}</span>
              <svg class="w-3.5 h-3.5 ml-auto opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          ))}

          <a
            href={`mailto:${EMAIL}`}
            class="group flex items-center gap-3 text-gray-400 hover:text-emerald-300 transition-colors"
            aria-label={t(lang, 'footer.aria_email')}
          >
            <span class="flex items-center justify-center w-9 h-9 rounded-lg border border-white/10 bg-white/[0.03] group-hover:border-emerald-500/40 group-hover:bg-emerald-500/[0.08] transition-colors">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={EMAIL_ICON_PATH} />
              </svg>
            </span>
            <span class="text-sm font-medium">{EMAIL}</span>
          </a>
        </div>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-500">
      <p>&copy; {today.getFullYear()} Camilo Taba. {t(lang, 'footer.rights')}</p>
      <p class="font-mono tracking-wide">{t(lang, 'footer.built_with')}</p>
      <a
        href="#home"
        class="group inline-flex items-center gap-1.5 hover:text-emerald-300 transition-colors"
        aria-label={t(lang, 'footer.aria_top')}
      >
        {t(lang, 'footer.back_to_top')}
        <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
        </svg>
      </a>
    </div>
  </div>
</footer>
