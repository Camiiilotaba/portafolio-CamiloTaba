<section id="contact" class="container mx-auto px-8 py-16">
    <h2 class="text-3xl font-bold text-green-500 mb-8 text-center">Contacto</h2>
  
    <p class="text-lg text-gray-300 text-center max-w-2xl mx-auto mb-6">
      ¿Quieres colaborar en un proyecto o simplemente saludar?  
      Envíame un mensaje y estaré encantado de responderte.
    </p>
  
    <form class="max-w-lg mx-auto bg-green-900 p-6 rounded-lg shadow-lg">
      <label class="block text-gray-300 text-lg font-semibold mb-2" for="name">Nombre</label>
      <input type="text" id="name" class="w-full p-3 rounded-lg bg-green-800 text-white border border-green-600 focus:outline-none focus:ring-2 focus:ring-green-400 mb-4" placeholder="Tu nombre"/>
  
      <label class="block text-gray-300 text-lg font-semibold mb-2" for="email">Correo Electrónico</label>
      <input type="email" id="email" class="w-full p-3 rounded-lg bg-green-800 text-white border border-green-600 focus:outline-none focus:ring-2 focus:ring-green-400 mb-4" placeholder="tucorreo@email.com"/>
  
      <label class="block text-gray-300 text-lg font-semibold mb-2" for="message">Mensaje</label>
      <textarea id="message" rows="4" class="w-full p-3 rounded-lg bg-green-800 text-white border border-green-600 focus:outline-none focus:ring-2 focus:ring-green-400 mb-4" placeholder="Escribe tu mensaje aquí..."></textarea>
  
      <button type="submit" class="w-full bg-green-500 text-white font-bold py-3 rounded-lg hover:bg-green-600 transition">
        Enviar Mensaje
      </button>
    </form>
  
    <div class="mt-8 text-center">
      <p class="text-gray-300">También puedes encontrarme en:</p>
      <div class="flex justify-center space-x-6 mt-4">
        <a href="https://github.com" target="_blank" class="text-green-400 hover:text-white text-2xl">
          <i class="fab fa-github"></i>
        </a>
        <a href="https://linkedin.com" target="_blank" class="text-green-400 hover:text-white text-2xl">
          <i class="fab fa-linkedin"></i>
        </a>
        <a href="mailto:tucorreo@email.com" class="text-green-400 hover:text-white text-2xl">
          <i class="fas fa-envelope"></i>
        </a>
      </div>
    </div>
  </section>
  