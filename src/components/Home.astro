---
import { Image } from "astro:assets";
import profileImg from "../assets/profile.jpg";
import type { Lang } from "../i18n/utils";
import { t } from "../i18n/utils";
import { GITHUB_URL, LINKEDIN_URL, GITHUB_ICON_PATH, LINKEDIN_ICON_PATH } from "../data/socials";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const cvHref = lang === 'es' ? '/CamiloTaba-CV.pdf' : '/CamiloTaba-CV-en.pdf';
---

<div class="mx-auto max-w-6xl px-5 pb-12 pt-10 sm:px-8 sm:py-24">
  <div class="flex flex-col-reverse items-start gap-6 md:flex-row md:items-center md:justify-between md:gap-14">
    <div class="max-w-2xl">
      <p class="font-heading text-xl font-semibold text-accent sm:text-2xl">{t(lang, 'home.greeting')}</p>
      <h1 class="mt-3 text-5xl font-bold leading-[1.02] text-ink sm:text-6xl lg:text-7xl">
        {t(lang, 'home.role')}
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-2 sm:text-xl">
        {t(lang, 'home.lead')}
      </p>
      <p class="mt-5 text-[15px] text-muted">
        {t(lang, 'home.context')}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href="#projects"
          class="inline-flex items-center gap-2 rounded-xl bg-accent px-6 py-3.5 font-semibold text-on-accent transition-colors hover:bg-ink"
        >
          {t(lang, 'home.cta_projects')}
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 5v14M6 13l6 6 6-6" />
          </svg>
        </a>
        <a
          href={cvHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl border border-line px-6 py-3.5 font-semibold text-ink transition-colors hover:border-ink-2"
          aria-label={t(lang, 'home.aria_cv')}
        >
          {t(lang, 'home.cta_cv')}
        </a>
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-12 w-12 items-center justify-center rounded-xl text-muted transition-colors hover:text-ink"
          aria-label={t(lang, 'home.aria_github')}
        >
          <svg viewBox="0 0 16 16" fill="currentColor" width="20" height="20" aria-hidden="true">
            <path d={GITHUB_ICON_PATH}></path>
          </svg>
        </a>
        <a
          href={LINKEDIN_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-12 w-12 items-center justify-center rounded-xl text-muted transition-colors hover:text-ink"
          aria-label={t(lang, 'home.aria_linkedin')}
        >
          <svg viewBox="0 0 16 16" fill="currentColor" width="20" height="20" aria-hidden="true">
            <path d={LINKEDIN_ICON_PATH}></path>
          </svg>
        </a>
      </div>
    </div>

    <Image
      src={profileImg}
      alt={t(lang, 'home.photo_alt')}
      class="h-24 w-24 shrink-0 rounded-2xl object-cover sm:h-32 sm:w-32 md:h-64 md:w-64 md:rounded-3xl lg:h-72 lg:w-72"
      width={288}
      height={288}
      densities={[1, 2]}
      loading="eager"
      fetchpriority="high"
      format="webp"
      quality={80}
    />
  </div>
</div>
