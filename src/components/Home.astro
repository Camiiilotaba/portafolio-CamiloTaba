---
import { Image } from "astro:assets";
import profileImg from "../assets/fotoperfil3.jpg";
import "../styles/home-animations.css";
import type { Lang } from "../i18n/utils";
import { t } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const coreTech = ["Laravel", "PHP", "MySQL", "REST APIs"];
const alsoTech = ["Vue", "React", "Flutter", "Tailwind CSS"];
---

<section class="hero-section relative w-full pt-6 pb-10 md:pb-14 overflow-hidden">
  <!-- Dot grid background -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="dots-bg absolute inset-0 opacity-20"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12 relative z-10 w-full">
    <div class="flex flex-col lg:flex-row items-center lg:justify-between gap-10 lg:gap-12 xl:gap-16">

      <!-- Text -->
      <div class="text-left w-full lg:max-w-[58%] space-y-5">

        <!-- Eyebrow (name as signature) -->
        <div class="animate-fade-in" style="--delay: 0s;">
          <span class="inline-block text-xs font-mono tracking-[0.25em] uppercase text-gray-500">
            {t(lang, 'home.eyebrow')}
          </span>
        </div>

        <!-- Headline (positioning) -->
        <div class="animate-fade-in" style="--delay: 0.05s;">
          <h1 class="font-bold leading-[0.95]">
            <span class="name-underline block text-5xl sm:text-6xl md:text-7xl xl:text-8xl text-green-400">
              {t(lang, 'home.headline_line1')}
            </span>
            <span class="block text-4xl sm:text-5xl md:text-6xl xl:text-7xl text-white mt-1">
              {t(lang, 'home.headline_line2')}
            </span>
          </h1>
        </div>

        <!-- Proof strip -->
        <div
          class="animate-fade-in border-y border-white/10 py-2.5"
          style="--delay: 0.15s;"
          aria-label="Current context"
        >
          <p
            class="text-xs font-bold tracking-widest uppercase text-white/45"
            set:html={t(lang, 'home.proof_strip')}
          />
        </div>

        <!-- Bio -->
        <p
          class="animate-fade-in text-base sm:text-lg leading-relaxed font-light text-gray-400 max-w-2xl"
          style="--delay: 0.2s;"
          set:html={t(lang, 'home.description')}
        />

        <!-- Tech stack — tiered -->
        <div
          class="animate-fade-in space-y-2"
          style="--delay: 0.25s;"
          role="list"
          aria-label={t(lang, 'home.aria_technologies')}
        >
          <!-- Core -->
          <div class="flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-2">
            <span class="text-[10px] font-mono tracking-widest uppercase text-green-400/70 sm:w-16 shrink-0">
              {t(lang, 'home.tech_core_label')}
            </span>
            <div class="flex flex-wrap items-center gap-2">
              {coreTech.map((pill) => (
                <span
                  class="tech-pill border border-green-500/30 bg-green-500/[0.06] text-white px-3 py-1 rounded text-xs tracking-wider uppercase transition-all duration-200 hover:border-green-400 hover:bg-green-500/10 cursor-default"
                  role="listitem"
                >{pill}</span>
              ))}
            </div>
          </div>

          <!-- Also ships -->
          <div class="flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-2">
            <span class="text-[10px] font-mono tracking-widest uppercase text-gray-600 sm:w-16 shrink-0">
              {t(lang, 'home.tech_also_label')}
            </span>
            <div class="flex flex-wrap items-center gap-2">
              {alsoTech.map((pill) => (
                <span
                  class="tech-pill border border-white/[0.08] bg-white/[0.02] text-gray-500 px-3 py-1 rounded text-xs tracking-wider uppercase transition-all duration-200 hover:border-white/20 hover:text-gray-400 cursor-default"
                  role="listitem"
                >{pill}</span>
              ))}
            </div>
          </div>
        </div>

        <!-- CTAs -->
        <div class="animate-fade-in flex flex-wrap items-center gap-3 pt-1" style="--delay: 0.3s;">
          <!-- Primary -->
          <a
            href="#contact"
            class="group inline-flex items-center gap-2 bg-green-400 hover:bg-green-300 text-black font-bold text-sm px-6 py-3 rounded-lg transition-all duration-200 hover:shadow-lg hover:shadow-green-500/30 hover:-translate-y-px"
            aria-label={t(lang, 'home.aria_contact')}
          >
            {t(lang, 'home.cta_contact')}
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>

          <!-- Secondary ghost -->
          <a
            href="/CamiloTaba-CV.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-gray-400 hover:text-green-300 font-medium text-sm px-4 py-3 rounded-lg transition-colors duration-200"
            aria-label={t(lang, 'home.aria_cv')}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            {t(lang, 'home.cta_cv')}
          </a>

          <!-- GitHub inline CTA -->
          <a
            href="https://github.com/Camiiilotaba"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 border border-white/[0.12] bg-white/[0.04] hover:border-green-500/40 hover:text-green-300 text-white font-medium text-sm px-4 py-3 rounded-lg transition-all duration-200 hover:-translate-y-px"
            aria-label={t(lang, 'home.aria_github')}
          >
            <svg viewBox="0 0 16 16" fill="currentColor" width="16" height="16" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
            </svg>
            {t(lang, 'home.cta_github')}
          </a>

          <!-- LinkedIn icon only -->
          <a
            href="https://www.linkedin.com/in/camilo-taba/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center w-11 h-11 border border-white/10 bg-white/[0.04] hover:border-green-500/40 hover:text-green-400 text-gray-400 rounded-lg transition-all duration-200 hover:-translate-y-px"
            aria-label={t(lang, 'home.aria_linkedin')}
          >
            <svg viewBox="0 0 16 16" fill="currentColor" width="18" height="18" aria-hidden="true">
              <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"></path>
            </svg>
          </a>
        </div>

      </div>

      <!-- Profile Image — visible from md+ -->
      <div class="hidden md:flex flex-col items-center flex-shrink-0 animate-fade-in" style="--delay: 0.15s;">
        <div class="relative group">
          <div class="absolute -inset-4 bg-gradient-to-br from-green-500/20 to-emerald-500/10 rounded-3xl blur-2xl opacity-0 group-hover:opacity-80 transition-opacity duration-500" aria-hidden="true"></div>
          <div class="relative bg-white/[0.04] border border-white/10 group-hover:border-green-500/30 rounded-3xl p-2 transition-all duration-500 shadow-2xl shadow-black/60">
            <Image
              src={profileImg}
              alt="Camilo Taba - Software Developer"
              class="w-40 h-40 md:w-48 md:h-48 lg:w-56 lg:h-56 xl:w-64 xl:h-64 2xl:w-72 2xl:h-72 rounded-2xl object-cover shadow-xl"
              width={288}
              height={288}
              loading="eager"
              format="webp"
              quality={80}
            />
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
