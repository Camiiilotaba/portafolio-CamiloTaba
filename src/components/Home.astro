---
import { Image } from "astro:assets";
import "../styles/home-animations.css";
import type { Lang } from "../i18n/utils";
import { t } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const mailtoSubject = encodeURIComponent(t(lang, 'home.mailto_subject'));
const mailtoBody = encodeURIComponent(t(lang, 'home.mailto_body'));
const techPills = ["PHP", "Laravel", "MySQL", "Flutter", "Tailwind CSS", "Clean Architecture"];
---

<section class="hero-section relative w-full pt-6 pb-10 md:pb-16 overflow-hidden">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 pt-20 sm:pt-24 md:pt-28 relative z-10">
    <div class="flex flex-col xl:flex-row items-center xl:justify-between gap-8 xl:gap-12">

      <!-- Text Content -->
      <div class="text-left xl:max-w-[55%] space-y-4 sm:space-y-5">
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-green-500 animate-fade-in">
          Camilo Taba
        </h1>

        <h2
          class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold text-white animate-fade-in"
          style="animation-delay: 0.1s;"
          set:html={t(lang, 'home.role')}
        />

        <p
          class="text-base sm:text-lg md:text-xl leading-relaxed font-light text-gray-300 animate-fade-in"
          style="animation-delay: 0.2s;"
          set:html={t(lang, 'home.description')}
        />

        <div
          class="flex flex-wrap gap-2 sm:gap-3 animate-fade-in"
          style="animation-delay: 0.3s;"
          role="list"
          aria-label={t(lang, 'home.aria_technologies')}
        >
          {techPills.map((pill) => (
            <span
              class="tech-pill backdrop-blur-md bg-white/5 border border-white/10 hover:border-green-500/50 hover:bg-white/10 text-gray-200 px-3 sm:px-4 py-1.5 sm:py-2 rounded-full text-xs sm:text-sm transition-all duration-300 hover:scale-105"
              role="listitem"
            >{pill}</span>
          ))}
        </div>

        <div
          class="flex flex-col sm:flex-row gap-3 sm:gap-4 pt-2 animate-fade-in"
          style="animation-delay: 0.4s;"
        >
          <a
            href={`mailto:camilotaba.dev@gmail.com?subject=${mailtoSubject}&body=${mailtoBody}`}
            class="group bg-gradient-to-r from-green-500 to-emerald-500 hover:from-green-600 hover:to-emerald-600 text-black font-bold px-6 sm:px-8 py-3 sm:py-4 rounded-xl transition-all duration-300 text-center text-sm sm:text-base hover:shadow-lg hover:shadow-green-500/50 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 focus:ring-offset-black inline-flex items-center justify-center hover:scale-105"
            aria-label={t(lang, 'home.aria_contact')}
          >
            <span>{t(lang, 'home.cta_contact')}</span>
            <svg class="w-4 h-4 sm:w-5 sm:h-5 ml-2 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>

          <a
            href="/CamiloTaba-CV.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="group backdrop-blur-md bg-white/5 hover:bg-white/10 border border-white/10 hover:border-green-500/50 text-white font-bold px-6 sm:px-8 py-3 sm:py-4 rounded-xl transition-all duration-300 text-center text-sm sm:text-base hover:shadow-lg hover:shadow-white/20 focus:outline-none focus:ring-2 focus:ring-white/50 focus:ring-offset-2 focus:ring-offset-black inline-flex items-center justify-center hover:scale-105"
            aria-label={t(lang, 'home.aria_cv')}
          >
            <span>{t(lang, 'home.cta_cv')}</span>
            <svg class="w-4 h-4 sm:w-5 sm:h-5 ml-2 transition-transform group-hover:translate-y-[-2px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </a>
        </div>

        <div
          class="flex gap-4 sm:gap-6 animate-fade-in"
          style="animation-delay: 0.5s;"
          role="navigation"
          aria-label={t(lang, 'home.aria_social')}
        >
          <a
            href="https://github.com/Camiiilotaba"
            target="_blank"
            rel="noopener noreferrer"
            class="backdrop-blur-md bg-white/5 hover:bg-white/10 border border-white/10 hover:border-green-500/50 p-3 rounded-xl transition-all duration-300 hover:scale-110 hover:shadow-lg hover:shadow-green-500/30 group"
            aria-label={t(lang, 'home.aria_github')}
          >
            <svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28" class="sm:w-8 sm:h-8 text-gray-300 group-hover:text-green-400 transition-colors duration-300" fill="currentColor">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/in/julian-camilo-blandon-taba-9b5210294/"
            target="_blank"
            rel="noopener noreferrer"
            class="backdrop-blur-md bg-white/5 hover:bg-white/10 border border-white/10 hover:border-green-500/50 p-3 rounded-xl transition-all duration-300 hover:scale-110 hover:shadow-lg hover:shadow-green-500/30 group"
            aria-label={t(lang, 'home.aria_linkedin')}
          >
            <svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28" class="sm:w-8 sm:h-8 text-gray-300 group-hover:text-green-400 transition-colors duration-300" fill="currentColor">
              <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Profile Image — visible from md+ -->
      <div class="hidden md:block flex-shrink-0 animate-fade-in" style="animation-delay: 0.3s;">
        <div class="relative group">
          <div class="absolute -inset-4 bg-gradient-to-r from-green-500/20 to-emerald-500/20 rounded-full blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative backdrop-blur-sm bg-white/5 p-2 rounded-full border border-white/10 group-hover:border-green-500/50 transition-all duration-500">
            <Image
              src="/img/fotoperfil3.jpg"
              alt="Camilo Taba - Software Developer"
              class="w-40 h-40 md:w-48 md:h-48 xl:w-64 xl:h-64 2xl:w-80 2xl:h-80 rounded-full object-cover transition-all duration-500 group-hover:scale-105 shadow-2xl shadow-black/50"
              width={320}
              height={320}
              loading="eager"
              format="webp"
              quality={80}
            />
          </div>
          <div class="absolute inset-0 rounded-full border-2 border-green-500/20 animate-ping-slow" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </div>
</section>
