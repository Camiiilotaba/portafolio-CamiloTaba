---
import type { Lang } from "../i18n/utils";
import { getLocalePath } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const options: { code: Lang; label: string; title: string }[] = [
  { code: 'en', label: 'EN', title: 'English' },
  { code: 'es', label: 'ES', title: 'Español' },
];
---

<div class="flex items-center rounded-full border border-line p-0.5 text-sm font-medium">
  {options.map(({ code, label, title }) => (
    <a
      href={getLocalePath(code)}
      class:list={[
        'rounded-full px-3 py-1.5 transition-colors',
        lang === code ? 'bg-surface-2 text-ink' : 'text-muted hover:text-ink',
      ]}
      hreflang={code}
      lang={code}
      title={title}
      aria-current={lang === code ? 'page' : undefined}
    >
      {label}
    </a>
  ))}
</div>
