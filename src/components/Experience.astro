---
import { experiences } from "../data/experience";
import type { Lang } from "../i18n/utils";
import { t } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
  <h2 class="text-3xl font-bold text-ink sm:text-4xl">{t(lang, 'experience.heading')}</h2>

  <ol class="mt-12 flex flex-col gap-6">
    {experiences.map((exp) => (
      <li class="grid gap-x-10 gap-y-3 rounded-3xl border border-line bg-surface p-6 sm:p-8 md:grid-cols-[220px_1fr]">
        <div>
          <p class="text-[15px] font-medium text-ink-2">{t(lang, exp.periodKey)}</p>
          <p class="mt-1 text-sm text-muted">{t(lang, exp.locationKey)}</p>
          {exp.isCurrent && (
            <p class="mt-3 inline-flex items-center gap-2 rounded-full bg-surface-2 px-3 py-1 text-sm text-ink-2">
              <span class="h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
              {t(lang, 'experience.current_badge')}
            </p>
          )}
        </div>

        <div class="min-w-0">
          <h3 class="text-2xl font-bold text-ink">
            {exp.companyUrl ? (
              <a
                href={exp.companyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="underline decoration-line underline-offset-4 transition-colors hover:decoration-accent"
              >
                {exp.company}
              </a>
            ) : (
              exp.company
            )}
          </h3>
          <p class="mt-1 font-medium text-accent">{t(lang, exp.roleKey)}</p>
          <p class="mt-4 leading-relaxed text-ink-2">{t(lang, exp.descriptionKey)}</p>

          <ul class="mt-4 flex flex-col gap-2.5">
            {exp.highlightKeys.map((key) => (
              <li class="flex gap-3 leading-relaxed text-ink-2">
                <span class="mt-[0.7em] h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                <span>{t(lang, key)}</span>
              </li>
            ))}
          </ul>

          <p class="mt-5 text-sm text-muted">
            {exp.technologies.map(({ name }) => name).join(' · ')}
          </p>
        </div>
      </li>
    ))}
  </ol>
</div>
