---
import { experiences } from "../data/experience";
import { getIconComponent } from "../icons/IconAll.astro";
import "../styles/experience-timeline.css";
import type { Lang } from "../i18n/utils";
import { t } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="container mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-12 relative z-10">
  <header class="text-center mb-8 lg:mb-10">
    <h2 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold mb-4">
      <span class="bg-gradient-to-r from-emerald-400 via-green-500 to-emerald-600 bg-clip-text text-transparent">
        {t(lang, 'experience.heading')}
      </span>
    </h2>
    <p class="text-gray-300 text-base sm:text-lg lg:text-xl max-w-2xl mx-auto leading-relaxed px-4">
      {t(lang, 'experience.subtitle')}
    </p>
    <div class="flex justify-center mt-6 mb-5">
      <div class="w-24 h-1 bg-gradient-to-r from-emerald-500 to-green-500 rounded-full"></div>
    </div>
  </header>

  <div class="relative max-w-4xl mx-auto">
    <!-- Timeline vertical line -->
    <div
      class="timeline-line absolute left-6 md:left-1/2 md:-translate-x-px top-0 bottom-0 w-0.5 bg-gradient-to-b from-green-500/50 via-emerald-500/30 to-transparent z-0"
      aria-hidden="true"
    ></div>

    {experiences.map((exp, index) => (
      <div
        class:list={[
          'experience-card relative mb-12 last:mb-0',
        ]}
        data-experience-index={index}
      >
        <div class="experience-card-inner flex items-start md:gap-8">
          <!-- Spacer for zigzag (hidden on mobile) -->
          <div class="hidden md:block md:w-1/2" />

          <!-- Timeline dot (centered on line) -->
          <div class="absolute left-6 md:left-1/2 -translate-x-1/2 top-6 z-10">
            <div
              class:list={[
                'timeline-dot relative w-4 h-4 rounded-full border-2',
                exp.isCurrent
                  ? 'bg-green-500 border-green-400 shadow-lg shadow-green-500/50'
                  : 'bg-gray-800 border-green-500/50',
              ]}
            >
              {exp.isCurrent && (
                <>
                  <div class="absolute inset-0 rounded-full bg-green-500 animate-ping opacity-40" aria-hidden="true"></div>
                  <span class="sr-only">{t(lang, 'experience.current_badge')}</span>
                </>
              )}
            </div>
          </div>

          <!-- Card -->
          <div
            class:list={[
              'experience-card-content ml-14 md:ml-0 md:w-1/2 z-20',
            ]}
          >
            <div
              class:list={[
                'experience-card-body relative backdrop-blur-md bg-white/5 border rounded-2xl p-5 sm:p-6 transition-all duration-300 hover:shadow-lg group overflow-hidden',
                exp.isCurrent
                  ? 'border-green-500/30 hover:border-green-500/60 hover:shadow-green-500/20'
                  : 'border-white/10 hover:border-green-500/50 hover:shadow-green-500/10',
              ]}
            >
              <!-- Glassmorphism hover overlay -->
              <div class="absolute inset-0 bg-gradient-to-br from-green-500/5 via-transparent to-emerald-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none rounded-2xl" aria-hidden="true"></div>

              <div class="relative z-10">
                <!-- Company + Current badge -->
                <div class="flex flex-wrap items-center gap-3 mb-2">
                  <h3 class="text-xl sm:text-2xl font-bold text-white group-hover:text-green-400 transition-colors duration-300">
                    {exp.companyUrl ? (
                      <a
                        href={exp.companyUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:underline decoration-green-500/50 underline-offset-4"
                      >
                        {exp.company}
                      </a>
                    ) : (
                      exp.company
                    )}
                  </h3>
                  {exp.isCurrent && (
                    <span class="px-3 py-1 text-xs font-bold rounded-full bg-green-500/20 text-green-400 border border-green-500/30 animate-pulse">
                      {t(lang, 'experience.current_badge')}
                    </span>
                  )}
                </div>

                <!-- Role -->
                <p class="text-green-400 font-semibold text-sm sm:text-base mb-1">
                  {t(lang, exp.roleKey)}
                </p>

                <!-- Location + Period -->
                <div class="flex flex-wrap gap-x-4 gap-y-1 text-gray-400 text-xs sm:text-sm mb-4">
                  <span class="flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    {t(lang, exp.locationKey)}
                  </span>
                  <span class="flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    {t(lang, exp.periodKey)}
                  </span>
                </div>

                <!-- Description -->
                <p class="text-gray-300 text-sm sm:text-base leading-relaxed mb-4">
                  {t(lang, exp.descriptionKey)}
                </p>

                <!-- Highlights (skip for 'brief' type) -->
                {exp.type === 'full' && (
                  <ul class="space-y-2 mb-4">
                    {exp.highlightKeys.map((hk) => (
                      <li class="flex items-start gap-2 text-gray-300 text-xs sm:text-sm">
                        <svg class="w-4 h-4 text-green-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                        </svg>
                        <span>{t(lang, hk)}</span>
                      </li>
                    ))}
                  </ul>
                )}

                <!-- Technology pills with optional icons -->
                <div class="flex flex-wrap gap-2" role="list" aria-label={t(lang, 'experience.heading')}>
                  {exp.technologies.map(({ name, icon }) => {
                    const IconComponent = icon ? getIconComponent(icon) : null;
                    return (
                      <span
                        class="tech-pill inline-flex items-center gap-1.5 backdrop-blur-md bg-white/5 border border-white/10 hover:border-green-500/50 hover:bg-white/10 text-gray-200 px-3 py-1 rounded-full text-xs font-medium transition-all duration-300 hover:scale-105"
                        role="listitem"
                      >
                        {IconComponent && (
                          <span class="flex-shrink-0 [&_i]:flex [&_i]:items-center [&_svg]:w-4 [&_svg]:h-4" aria-hidden="true">
                            <IconComponent />
                          </span>
                        )}
                        {name}
                      </span>
                    );
                  })}
                </div>
              </div>

              <!-- Bottom accent line -->
              <div class="absolute bottom-0 left-0 w-full h-0.5 bg-gradient-to-r from-green-500 via-emerald-400 to-green-500 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-700 origin-left rounded-b-2xl" aria-hidden="true"></div>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

