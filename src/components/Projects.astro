---
import { projects } from "../data/projects";
import { t } from "../i18n/utils";
import type { Lang } from "../i18n/utils";
import FeaturedProject from "./FeaturedProject.astro";
import CompactProjectCard from "./CompactProjectCard.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const featured = projects.find((p) => p.featured);
const secondary = projects.filter((p) => !p.featured);
---

<section
  id="projects"
  class="relative bg-gradient-to-b from-black via-emerald-950 to-black py-20 overflow-hidden"
>
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-green-500/10 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 pt-25 relative z-10">
    <header class="text-center mb-12 lg:mb-16 xl:mb-20">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold mb-4">
        <span class="bg-gradient-to-r from-emerald-400 via-green-500 to-emerald-600 bg-clip-text text-transparent">
          {t(lang, 'projects.heading')}
        </span>
      </h2>
      <p class="text-gray-300 text-base sm:text-lg lg:text-xl max-w-2xl mx-auto leading-relaxed px-4">
        {t(lang, 'projects.subtitle')}
      </p>
      <div class="flex justify-center mt-6 mb-5">
        <div class="w-24 h-1 bg-gradient-to-r from-emerald-500 to-green-500 rounded-full"></div>
      </div>
    </header>

    <!-- Featured Case Study -->
    {featured && (
      <div class="mb-8 lg:mb-12">
        <FeaturedProject project={featured} lang={lang} />
      </div>
    )}

    <!-- Secondary Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {secondary.map((project, index) => (
        <CompactProjectCard project={project} lang={lang} index={index + 1} />
      ))}
    </div>
  </div>

</section>
