---
import { projects } from "../data/projects";
import { t } from "../i18n/utils";
import type { Lang } from "../i18n/utils";
import FeaturedProject from "./FeaturedProject.astro";
import CompactProjectCard from "./CompactProjectCard.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const featured = projects.find((p) => p.featured);
const secondary = projects.filter((p) => !p.featured);
---

<section
  class="relative pb-20 overflow-hidden"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 pt-25 relative z-10">
    <header class="reveal-on-scroll text-center mb-12 lg:mb-16 xl:mb-20">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold mb-4">
        <span class="bg-gradient-to-r from-emerald-400 via-green-500 to-emerald-600 bg-clip-text text-transparent">
          {t(lang, 'projects.heading')}
        </span>
      </h2>
      <div class="flex justify-center mt-6 mb-5">
        <div
          class="scroll-draw w-24 h-1 rounded-full"
          style="background: linear-gradient(90deg, var(--accent-bright), var(--accent), var(--accent-deep));"
        ></div>
      </div>
    </header>

    <!-- Featured Case Study -->
    {featured && (
      <div class="mb-8 lg:mb-12">
        <FeaturedProject project={featured} lang={lang} />
      </div>
    )}

    <!-- Secondary Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {secondary.map((project, index) => (
        <CompactProjectCard project={project} lang={lang} index={index + 1} />
      ))}
    </div>
  </div>

</section>
