---
import { projects } from "../consts";
import { getIconComponent } from "../icons/IconAll.astro";
---

<div id="projects" class="container mx-auto px-8 py-16">
  <h2 class="text-3xl font-bold text-white mb-8 2xl:mb-15 text-center">Proyectos</h2>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 xl:grid-cols-3 gap-8 md:justify-center lg:justify-center">
    {projects.map(({ description, img, link, technologies, title }) => (
      <div class="relative bg-gray-900 p-6 rounded-lg shadow-lg flex flex-col transition-transform transform hover:-translate-y-2 border border-gray-700">
        <img src={img} alt={title} class="w-full h-48 object-cover rounded-md" loading="lazy" />
        <h3 class="text-2xl font-semibold text-white mt-4">{title}</h3>
        <p class="text-gray-300 flex-grow line-clamp-3">{description}</p>
        <p class="text-green-300 mt-4">Tecnologías usadas:</p>
        <div class="flex gap-4 flex-wrap mt-2 text-white">
          {technologies.map(({ icon }) => {
            const IconComponent = getIconComponent(icon);
            return IconComponent && <i class="text-2xl">{<IconComponent />}</i>;
          })}
        </div>
        <a href={link} target="_blank" class="mt-4 inline-block bg-green-600 text-white px-4 py-2 rounded-md transition-colors hover:bg-green-500">
          Ver más
        </a>
        <div class="absolute bottom-0 left-0 w-full h-1 bg-black opacity-30 transition-all duration-300 group-hover:h-full"></div>
      </div>
    ))}
  </div>
</div>

