---
import { skills, stats } from "../data/skills";
import type { Lang } from "../i18n/utils";
import { t } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="container mx-auto px-8 py-16" aria-labelledby="skills-heading">
  <header class="text-center mb-12 mt-10 2xl:mb-0">
    <h2 id="skills-heading" class="text-4xl md:text-5xl font-bold text-green-500 mb-4">
      {t(lang, 'about.heading')}
    </h2>
    <p class="text-gray-300 text-lg max-w-2xl mx-auto leading-relaxed">
      {t(lang, 'about.subtitle')}
    </p>
    <div class="flex justify-center mt-6">
      <div class="w-20 h-0.5 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full"></div>
    </div>
  </header>

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-5 gap-6 justify-items-center mb-16">
    {skills.map(({ name, img, link }, index) => (
      <div class="skill-card group relative w-full max-w-[120px]" data-skill-index={index}>
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center p-4 rounded-2xl bg-gradient-to-br from-gray-900/90 to-black/70 backdrop-blur-sm border border-gray-800/50 hover:border-green-500/50 transition-all duration-500 shadow-2xl shadow-black/50 hover:shadow-green-500/20 hover:-translate-y-2 w-full"
          aria-label={t(lang, 'about.aria_learn_more').replace('{name}', name)}
        >
          <div class="absolute inset-0 bg-gradient-to-br from-green-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none rounded-2xl" aria-hidden="true"></div>
          <div class="relative mb-3 z-10">
            <img
              src={img}
              alt={`${name} icon`}
              class="w-12 h-12 transition-all duration-300 group-hover:scale-110 group-hover:rotate-3 filter group-hover:drop-shadow-lg"
              loading="lazy"
              width="48"
              height="48"
              decoding="async"
              fetchpriority="low"
            />
          </div>
          <span class="text-gray-300 font-medium text-center group-hover:text-green-400 transition-colors duration-300 text-sm relative z-10">
            {name}
          </span>
          <div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-green-500 to-emerald-500 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left rounded-b-2xl" aria-hidden="true"></div>
        </a>
      </div>
    ))}
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
    {stats.map(({ number, labelKey, color }, index) => (
      <div class="stat-card group relative" data-stat-index={index}>
        <div class="bg-gradient-to-br from-gray-900/90 to-black/70 backdrop-blur-sm p-6 rounded-2xl border border-gray-800/50 hover:border-green-500/50 transition-all duration-300 shadow-2xl shadow-black/50 hover:shadow-green-500/20">
          <div class="absolute inset-0 bg-gradient-to-br from-green-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none rounded-2xl" aria-hidden="true"></div>
          <div class={`text-3xl font-bold ${color} mb-2 relative z-10`}>{number}</div>
          <div class="text-gray-300 relative z-10">{t(lang, labelKey)}</div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  import "../scripts/about-animations.ts";
</script>
