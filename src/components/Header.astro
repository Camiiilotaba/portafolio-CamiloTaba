---
import HeaderLink from "./HeaderLink.astro";
---

<header class="header">
  <div class="header-container">
    <!-- Logo -->
    <div class="logo-section">
      <img src="/img/logooo.png" alt="Logo" class="logo-img" />
      <span class="logo-text"></span>
    </div>

    <!-- Navigation and Controls -->
    <div class="nav-controls">
      <!-- Navigation Menu -->
      <nav class="nav-menu" id="nav-menu">
        <HeaderLink href="#" class="nav-link">Inicio</HeaderLink>

        <HeaderLink href="#projects" class="nav-link">Proyectos</HeaderLink>
        <HeaderLink href="#about" class="nav-link">Habilidades</HeaderLink>
      </nav>

  <!-- Header accent line -->
  <div class="header-accent"></div>
</header>


<!-- Cargar scripts externos -->
<script>
  import "../scripts/menuToggle.ts";
  import "../scripts/toggleTheme.js";
  import "../scripts/changeLanguage.js";
</script>