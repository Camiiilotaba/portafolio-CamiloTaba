---
import HeaderLink from "./HeaderLink.astro";
---

<header class="bg-black shadow">
  <div class="container mx-auto px-2 lg:px-0 py-4 flex justify-between items-center">
    <!-- Logo -->
    <div class="flex items-center">
      <img src="/img/logooo.png" alt="Logo" class="h-20 w-25 object-contain" />
      <span class="ml-2 text-lg font-semibold text-white"></span>
    </div>

    <div class="flex items-center space-x-4">
      <!-- Selector de idioma -->
      <form class="max-w-sm mx-auto">
        <label for="underline_select" class="sr-only">Underline select</label>
        <select
          id="language-select"
          class="block py-2.5 px-0 w-full text-sm text-gray-100 bg-black border-0 appearance-none dark:text-gray-400 dark:border-gray-700 focus:outline-none focus:ring-0 focus:border-gray-200 peer"
        >
          <option value="" selected>Spanish 🇪🇸</option>
          <option value="EN">English 🇬🇧</option>
        </select>
      </form>

    
    </div>
  </div>
</header>

<!-- Cargar scripts externos -->
<script>
  import "../scripts/menuToggle.ts";
  import "../scripts/toggleTheme.js";
  import "../scripts/changeLanguage.js";
</script>