---
import { Image } from "astro:assets";
import logoImg from "../assets/logooo.png";
import type { Lang } from "../i18n/utils";
import { t, getLocalePath } from "../i18n/utils";
import LanguageToggle from "./LanguageToggle.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const navLinks = [
  { href: '#home', key: 'nav.home' },
  { href: '#projects', key: 'nav.projects' },
  { href: '#experience', key: 'nav.experience' },
  { href: '#contact', key: 'nav.contact' },
];
---

<header class="header">
  <div class="header-container">
    <div class="logo-section">
      <a href={getLocalePath(lang)}>
        <Image
          src={logoImg}
          alt="Camilo Taba"
          class="logo-img"
          width={256}
          height={200}
          format="webp"
          quality={90}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </a>
    </div>

    <div class="nav-controls">
      <!-- Desktop nav -->
      <nav class="nav-menu" id="nav-menu" aria-label="Main navigation">
        {navLinks.filter(({ href }) => href !== '#contact').map(({ href, key }) => (
          <a href={href} class="nav-link">{t(lang, key)}</a>
        ))}
      </nav>

      <!-- Contact CTA (desktop) -->
      <a href="#contact" class="nav-cta" aria-label={t(lang, 'home.aria_contact')}>
        {t(lang, 'nav.contact')}
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>

      <LanguageToggle lang={lang} />

      <!-- Mobile hamburger -->
      <button
        class="mobile-toggle"
        id="mobile-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>

  <!-- Mobile dropdown menu -->
  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation">
    <div class="mobile-nav">
      {navLinks.map(({ href, key }) => (
        <a href={href} class="mobile-nav-link">{t(lang, key)}</a>
      ))}

      <div class="mobile-social">
        <a href="https://github.com/Camiiilotaba" target="_blank" rel="noopener noreferrer" aria-label={t(lang, 'footer.aria_github')}>
          <svg viewBox="0 0 16 16" fill="currentColor" width="20" height="20" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
          </svg>
        </a>
        <a href="https://www.linkedin.com/in/camilotaba/" target="_blank" rel="noopener noreferrer" aria-label={t(lang, 'footer.aria_linkedin')}>
          <svg viewBox="0 0 16 16" fill="currentColor" width="20" height="20" aria-hidden="true">
            <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z" />
          </svg>
        </a>
        <a href="mailto:camilotaba.dev@gmail.com" aria-label={t(lang, 'footer.aria_email')}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </a>
      </div>
    </div>
  </nav>

  <div class="header-accent"></div>
</header>

<script>
  function initHeader(): void {
    const toggle = document.getElementById('mobile-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;

    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.contains('show');
      menu.classList.toggle('show');
      toggle.classList.toggle('active');
      toggle.setAttribute('aria-expanded', String(!isOpen));

      // Prevent body scroll when menu is open
      document.body.style.overflow = isOpen ? '' : 'hidden';
    });

    // Close menu when clicking a link
    menu.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.remove('show');
        toggle.classList.remove('active');
        toggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      });
    });

    // Close menu on resize to desktop
    const mql = window.matchMedia('(min-width: 768px)');
    mql.addEventListener('change', (e) => {
      if (e.matches) {
        menu.classList.remove('show');
        toggle.classList.remove('active');
        toggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }
    });
  }

  // Active nav link highlighting on scroll — cached offsets to avoid layout thrashing
  function initActiveNav(): void {
    const sections = Array.from(document.querySelectorAll<HTMLElement>('section[id]'));
    const navLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('.nav-link, .mobile-nav-link')
    );
    if (!sections.length || !navLinks.length) return;

    const offsets: { id: string; top: number }[] = [];
    let lastActiveId = '';

    function recomputeOffsets(): void {
      offsets.length = 0;
      const docTop = window.scrollY;
      for (const section of sections) {
        const top = section.getBoundingClientRect().top + docTop;
        offsets.push({ id: section.id, top });
      }
    }

    function updateActiveLink(): void {
      const scrollY = window.scrollY + 120;

      let currentId = '';
      for (let i = 0; i < offsets.length; i++) {
        if (offsets[i].top <= scrollY) currentId = offsets[i].id;
      }

      if (currentId === lastActiveId) return;
      lastActiveId = currentId;

      const target = `#${currentId}`;
      for (const link of navLinks) {
        if (link.getAttribute('href') === target) {
          link.classList.add('active');
        } else {
          link.classList.remove('active');
        }
      }
    }

    let ticking = false;
    function onScroll(): void {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        updateActiveLink();
        ticking = false;
      });
    }

    let resizeRaf = 0;
    function onResize(): void {
      if (resizeRaf) return;
      resizeRaf = requestAnimationFrame(() => {
        recomputeOffsets();
        updateActiveLink();
        resizeRaf = 0;
      });
    }

    recomputeOffsets();
    updateActiveLink();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize, { passive: true });
    // Recompute when fonts/images settle to capture final layout
    window.addEventListener('load', () => {
      recomputeOffsets();
      updateActiveLink();
    });
  }

  function init(): void {
    initHeader();
    initActiveNav();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
