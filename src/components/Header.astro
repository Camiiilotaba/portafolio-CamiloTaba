---
import HeaderLink from "./HeaderLink.astro";
---

<header class="bg-black shadow border-b border-b-emerald-950">
  <div
    class="container mx-auto px-2 lg:px-0 py-4 flex justify-between items-center"
  >
    <!-- Logo -->
    <div class="flex items-center">
      <img src="/img/logooo.png" alt="Logo" class="h-20 w-25 object-contain" />
      <span class="ml-2 text-lg font-semibold text-white"></span>
    </div>

    <!-- Boton movil (menu) -->
    <button
      id="menuButton"
      class="lg:hidden text-white focus:outline-none"
      aria-expanded="false"
      aria-controls="dropdownMenu"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-6 h-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16m-7 6h7"></path>
      </svg>
    </button>

    <!-- Menu nav -->
    <nav id="menu" class="hidden lg:flex space-x-8 text-white ">
      <a href="/" class="text-lg font-medium">Inicio</a>


      <a href="/proyectos" class="text-lg font-medium">Proyectos</a>
      <a href="/contacto" class="text-lg font-medium">Contacto</a>
    </nav>

    <!-- Selector de idioma y Modo Oscuro -->
    <div class="flex items-center space-x-4">
      <!-- Selector de idioma -->
      <select
        id="language-select"
        class="bg-gray-800 text-white px-4 py-2 rounded cursor-pointer"
      >
        <option value="#" selected>Español 🇪🇸</option>
        <option value="english.html">English 🇬🇧</option>
      </select>

      <!-- Botón de modo oscuro/claro -->
      <button
        id="theme-toggle"
        class="bg-gray-800 text-white px-4 py-2 rounded transition"
      >
        🌙
      </button>
    </div>
  </div>
</header>

<!-- Cargar scripts externos -->
<script>
  import "../scripts/menuToggle.ts";
  import "../scripts/toggleTheme.js";
  import "../scripts/changeLanguage.js";
</script>
