---
import type { Lang } from "../i18n/utils";
import { t, getLocalePath } from "../i18n/utils";
import HeaderLink from "./HeaderLink.astro";
import LanguageToggle from "./LanguageToggle.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<header class="header">
  <div class="header-container">
    <div class="logo-section">
      <a href={getLocalePath(lang)}>
        <img
          src="/img/logooo.png"
          alt="Camilo Taba"
          class="logo-img"
          width="180"
          height="72"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </a>
    </div>

    <div class="nav-controls">
      <nav class="nav-menu" id="nav-menu">
        <HeaderLink href="#home" class="nav-link">{t(lang, 'nav.home')}</HeaderLink>
        <HeaderLink href="#projects" class="nav-link">{t(lang, 'nav.projects')}</HeaderLink>
        <HeaderLink href="#experience" class="nav-link">{t(lang, 'nav.experience')}</HeaderLink>
        <HeaderLink href="#about" class="nav-link">{t(lang, 'nav.skills')}</HeaderLink>
        <HeaderLink href="#contact" class="nav-link">{t(lang, 'nav.contact')}</HeaderLink>
      </nav>
      <LanguageToggle lang={lang} />
    </div>
  </div>

  <div class="header-accent"></div>
</header>

<script>
  import "../scripts/menuToggle.ts";
</script>
