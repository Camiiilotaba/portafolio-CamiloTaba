---
import Layout from "../layouts/Layout.astro";
import Footer from "./Footer.astro";

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<Layout lang="es" title={`${title} · Camilo Taba`} description={description} alternates={false}>
  <header class="border-b border-line">
    <div class="mx-auto flex h-16 max-w-3xl items-center justify-between gap-4 px-5 sm:px-8">
      <a href="/es/" class="font-heading text-xl font-bold text-ink transition-colors hover:text-accent">Camilo Taba</a>
      <a href="/es/" class="text-[15px] font-medium text-ink-2 transition-colors hover:text-ink">← Volver al inicio</a>
    </div>
  </header>

  <main id="main" class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <h1 class="text-4xl font-bold text-ink sm:text-5xl">{title}</h1>
    <p class="mt-3 text-sm text-muted">Última actualización: {updated}</p>
    <div class="legal mt-10">
      <slot />
    </div>
  </main>

  <Footer lang="es" />
</Layout>

<style>
  .legal :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-ink);
  }
  .legal :global(p),
  .legal :global(li) {
    color: var(--color-ink-2);
    line-height: 1.7;
  }
  .legal :global(p) {
    margin-top: 1rem;
  }
  .legal :global(ul) {
    margin-top: 1rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .legal :global(li + li) {
    margin-top: 0.5rem;
  }
  .legal :global(a) {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 3px;
  }
  .legal :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
</style>
