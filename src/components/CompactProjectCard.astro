---
import { Image } from "astro:assets";
import { getIconComponent } from "../icons/IconAll.astro";
import type { Lang } from "../i18n/utils";
import { t } from "../i18n/utils";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  lang: Lang;
  index: number;
}

const { project, lang, index } = Astro.props;
---

<article
  class="project-card group relative backdrop-blur-md bg-white/5 border border-white/10 hover:border-green-500/50 rounded-2xl overflow-hidden transition-all duration-300 hover:shadow-lg hover:shadow-green-500/10 h-full"
  data-project-index={index}
>
  <!-- Image -->
  <div class="relative overflow-hidden">
    <Image
      src={project.img}
      alt={`${project.title} - project screenshot`}
      class="w-full h-44 sm:h-48 object-cover transition-transform duration-500 group-hover:scale-105"
      width={400}
      height={192}
      format="webp"
      quality={80}
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent" aria-hidden="true"></div>

    <!-- Category badge -->
    <span class="absolute top-3 left-3 px-3 py-1 text-xs font-bold rounded-full bg-green-500/20 text-green-400 border border-green-500/30 backdrop-blur-sm">
      {t(lang, project.categoryKey)}
    </span>
  </div>

  <!-- Content -->
  <div class="p-5 sm:p-6 flex flex-col flex-grow">
    <h3 class="text-lg sm:text-xl font-bold text-white mb-1 group-hover:text-green-400 transition-colors duration-300">
      {project.title}
    </h3>
    <p class="text-gray-400 text-sm mb-4 leading-relaxed">
      {t(lang, project.headlineKey)}
    </p>

    <!-- Impact tags -->
    <div class="flex flex-wrap gap-1.5 mb-4">
      {project.impactTags.map((tag) => (
        <span class="px-2.5 py-0.5 text-xs font-medium rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          {tag}
        </span>
      ))}
    </div>

    <!-- Tech pills -->
    <div class="flex flex-wrap gap-1.5 mb-5 mt-auto">
      {project.technologies.map(({ name, icon }) => {
        const IconComponent = icon ? getIconComponent(icon) : null;
        return (
          <span class="tech-pill inline-flex items-center gap-1 backdrop-blur-md bg-white/5 border border-white/10 text-gray-300 px-2.5 py-0.5 rounded-full text-xs font-medium">
            {IconComponent && (
              <span class="flex-shrink-0 [&_i]:flex [&_i]:items-center [&_svg]:w-3 [&_svg]:h-3" aria-hidden="true">
                <IconComponent />
              </span>
            )}
            {name}
          </span>
        );
      })}
    </div>

    <!-- CTA -->
    {project.link && (
      <a
        href={project.link}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-green-400 hover:text-green-300 text-sm font-semibold transition-colors duration-300 group/link"
        aria-label={`${t(lang, 'projects.view_project')} - ${project.title}`}
      >
        {t(lang, 'projects.view_project')}
        <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    )}
  </div>
</article>
