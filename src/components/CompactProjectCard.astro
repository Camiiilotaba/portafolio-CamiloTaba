---
import { Image } from "astro:assets";
import { getIconComponent } from "../icons/IconAll.astro";
import type { Lang } from "../i18n/utils";
import { t } from "../i18n/utils";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  lang: Lang;
  index: number;
}

const { project, lang, index } = Astro.props;

// Live/deployed projects get a stronger visual treatment so they stand out.
const isLive = project.statusLabelKey === 'projects.status_live';
---

<article
  class:list={[
    "project-card group relative backdrop-blur-md rounded-2xl overflow-hidden transition-all duration-300 h-full",
    isLive
      ? "bg-green-500/[0.06] border border-green-500/40 hover:border-green-500/70 hover:shadow-lg hover:shadow-green-500/20"
      : "bg-white/5 border border-white/10 hover:border-green-500/50 hover:shadow-lg hover:shadow-green-500/10",
  ]}
  data-project-index={index}
>
  <div class="relative overflow-hidden">
    <Image
      src={project.img}
      alt={`${project.title} - project screenshot`}
      class="w-full h-44 sm:h-48 object-cover transition-transform duration-500 group-hover:scale-105"
      width={512}
      height={288}
      densities={[2]}
      format="webp"
      quality={86}
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent" aria-hidden="true"></div>

    <span class="absolute top-3 left-3 inline-flex items-center gap-1.5 px-3 py-1 text-xs font-bold rounded-full bg-green-500/20 text-green-400 border border-green-500/30 backdrop-blur-sm">
      {isLive && (
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75 animate-ping"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-green-400"></span>
        </span>
      )}
      {t(lang, project.categoryKey)}
    </span>

    {project.isPrivate && (
      <span class="absolute top-3 right-3 px-2.5 py-0.5 text-xs font-semibold rounded-full bg-black/60 text-gray-300 border border-white/15 backdrop-blur-sm">
        {t(lang, 'projects.status_private_badge')}
      </span>
    )}
  </div>

  <div class="p-5 sm:p-6 flex flex-col flex-grow">
    <h3 class="text-lg sm:text-xl font-bold text-white mb-1 group-hover:text-green-400 transition-colors duration-300">
      {project.title}
    </h3>
    <p class="text-gray-400 text-sm mb-4 leading-relaxed">
      {t(lang, project.headlineKey)}
    </p>

    {project.sections && project.sections.length > 0 && (
      <div class="mb-4" data-tabs>
        <div class="flex flex-wrap gap-1.5 mb-3" role="tablist" aria-label={project.title}>
          {project.sections.map((section, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${project.id}-${section.id}`}
              aria-controls={`panel-${project.id}-${section.id}`}
              data-tab-btn={section.id}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="tab-btn px-3 py-1 rounded-full text-xs font-semibold border transition-all duration-200 cursor-pointer text-gray-300 border-white/15 hover:border-green-500/40 hover:text-white aria-selected:bg-green-500 aria-selected:text-black aria-selected:border-green-500"
            >
              {t(lang, section.labelKey)}
            </button>
          ))}
        </div>

        {project.sections.map((section, i) => {
          const lines = t(lang, section.bodyKey)
            .split("\n")
            .map((line) => line.trim())
            .filter(Boolean);
          return (
            <div
              role="tabpanel"
              id={`panel-${project.id}-${section.id}`}
              aria-labelledby={`tab-${project.id}-${section.id}`}
              data-tab-panel={section.id}
              class={i === 0 ? "" : "hidden"}
            >
              {lines.length > 1 ? (
                <ul class="space-y-2">
                  {lines.map((line) => (
                    <li class="flex gap-2 text-gray-200 text-sm leading-relaxed">
                      <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{line}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="text-gray-200 text-sm leading-relaxed">{lines[0]}</p>
              )}
            </div>
          );
        })}
      </div>
    )}

    <div class="flex flex-wrap gap-1.5 mb-4">
      {project.impactTags.map((tag) => (
        <span class="px-2.5 py-0.5 text-xs font-medium rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          {tag}
        </span>
      ))}
    </div>

    <div class="flex flex-wrap gap-1.5 mb-5 mt-auto">
      {project.technologies.map(({ name, icon }) => {
        const IconComponent = icon ? getIconComponent(icon) : null;
        return (
          <span class="tech-pill inline-flex items-center gap-1 bg-white/[0.07] border border-white/[0.12] text-gray-300 px-2.5 py-0.5 rounded-full text-xs font-medium">
            {IconComponent && (
              <span class="flex-shrink-0 [&_i]:flex [&_i]:items-center [&_svg]:w-3 [&_svg]:h-3" aria-hidden="true">
                <IconComponent />
              </span>
            )}
            {name}
          </span>
        );
      })}
    </div>

    {project.link && (
      isLive ? (
        <a
          href={project.link}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 self-start bg-gradient-to-r from-green-500 to-emerald-500 hover:from-green-600 hover:to-emerald-600 text-black font-semibold py-2 px-4 rounded-lg text-sm transition-all duration-300 hover:shadow-lg hover:shadow-green-500/40 hover:scale-[1.02]"
          aria-label={`${t(lang, project.statusLabelKey)} - ${project.title}`}
        >
          {t(lang, project.statusLabelKey)}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      ) : (
        <a
          href={project.link}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-green-400 hover:text-green-300 text-sm font-semibold transition-colors duration-300 group/link"
          aria-label={`${t(lang, project.statusLabelKey)} - ${project.title}`}
        >
          {t(lang, project.statusLabelKey)}
          <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )
    )}
  </div>
</article>
