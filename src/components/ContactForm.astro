---
import type { Lang } from "../i18n/utils";
import { t } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
  <header class="reveal-on-scroll text-center mb-12 lg:mb-16">
    <h2 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold mb-4">
      <span class="bg-gradient-to-r from-emerald-400 via-green-500 to-emerald-600 bg-clip-text text-transparent">
        {t(lang, 'contact.heading')}
      </span>
    </h2>
    <p class="text-gray-300 text-base sm:text-lg lg:text-xl max-w-2xl mx-auto leading-relaxed px-4">
      {t(lang, 'contact.subtitle')}
    </p>
    <div class="flex justify-center mt-6">
      <div
        class="scroll-draw w-24 h-1 rounded-full"
        style="background: linear-gradient(90deg, var(--accent-bright), var(--accent), var(--accent-deep));"
      ></div>
    </div>
  </header>

  <form
    id="contact-form"
    class="max-w-xl mx-auto w-full backdrop-blur-md bg-white/5 border border-white/10 hover:border-green-500/30 p-6 sm:p-8 rounded-2xl shadow-2xl transition-all duration-300"
    method="POST"
    action="https://formspree.io/f/xnnllzpo"
    data-success-msg={t(lang, 'contact.success')}
    data-error-msg={t(lang, 'contact.error')}
  >
    <!-- Honeypot: Formspree discards the submission if this field arrives filled (bots) -->
    <input
      type="text"
      name="_gotcha"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="hidden"
    />

    <div class="mb-6">
      <label class="block text-xs font-mono uppercase tracking-wider text-gray-400 mb-2" for="name">
        {t(lang, 'contact.name_label')}
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        class="w-full p-3 sm:p-4 rounded-xl backdrop-blur-md bg-white/5 border border-white/10 focus:border-green-500/50 focus:bg-white/10 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500/30 transition-all duration-300"
        placeholder={t(lang, 'contact.name_placeholder')}
      />
    </div>

    <div class="mb-6">
      <label class="block text-xs font-mono uppercase tracking-wider text-gray-400 mb-2" for="email">
        {t(lang, 'contact.email_label')}
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="w-full p-3 sm:p-4 rounded-xl backdrop-blur-md bg-white/5 border border-white/10 focus:border-green-500/50 focus:bg-white/10 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500/30 transition-all duration-300"
        placeholder={t(lang, 'contact.email_placeholder')}
      />
    </div>

    <div class="mb-6">
      <label class="block text-xs font-mono uppercase tracking-wider text-gray-400 mb-2" for="message">
        {t(lang, 'contact.message_label')}
      </label>
      <textarea
        id="message"
        name="message"
        rows="5"
        required
        class="w-full p-3 sm:p-4 rounded-xl backdrop-blur-md bg-white/5 border border-white/10 focus:border-green-500/50 focus:bg-white/10 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500/30 transition-all duration-300 resize-none"
        placeholder={t(lang, 'contact.message_placeholder')}></textarea>
    </div>

    <button
      type="submit"
      id="submit-btn"
      class="w-full bg-gradient-to-r from-green-500 to-emerald-500 hover:from-green-600 hover:to-emerald-600 text-black font-bold px-6 py-3 sm:py-4 rounded-xl transition-all duration-300 hover:shadow-lg hover:shadow-green-500/50 disabled:opacity-50 disabled:cursor-not-allowed hover:scale-105 inline-flex items-center justify-center gap-2 group"
    >
      <span id="submit-text">{t(lang, 'contact.submit')}</span>
      <span id="submit-loading" class="hidden">{t(lang, 'contact.sending')}</span>
      <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
      </svg>
    </button>

    <div id="form-message" class="mt-4 text-center hidden"></div>
  </form>

  <p class="text-center text-sm text-gray-400 mt-8">
    {t(lang, 'contact.direct_heading')}{' '}
    <a
      href="mailto:camilotaba.dev@gmail.com"
      class="font-medium text-emerald-400 hover:text-emerald-300 underline underline-offset-2 decoration-emerald-500/40 transition-colors"
    >camilotaba.dev@gmail.com</a>
  </p>
</div>

<script>
  import "../scripts/contact-form.ts";
</script>
