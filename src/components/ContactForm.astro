---
import type { Lang } from "../i18n/utils";
import { t } from "../i18n/utils";
import { EMAIL } from "../data/socials";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const fieldClass =
  "w-full rounded-xl border border-line bg-surface-2 px-4 py-3.5 text-ink placeholder:text-muted transition-colors focus:border-accent focus:outline-none";
---

<div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 sm:px-8 sm:py-24 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
  <div>
    <h2 class="text-3xl font-bold text-ink sm:text-4xl">{t(lang, 'contact.heading')}</h2>
    <p class="mt-4 max-w-md text-lg leading-relaxed text-ink-2">{t(lang, 'contact.subtitle')}</p>

    <p class="mt-8 text-sm text-muted">{t(lang, 'contact.direct_heading')}</p>
    <div class="mt-2 flex flex-wrap items-center gap-3">
      <a
        href={`mailto:${EMAIL}`}
        class="text-xl font-medium text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-accent"
      >
        {EMAIL}
      </a>
      <button
        type="button"
        id="copy-email"
        data-email={EMAIL}
        data-copied={t(lang, 'contact.copied')}
        class="rounded-lg border border-line px-3 py-1.5 text-sm font-medium text-ink-2 transition-colors hover:text-ink"
      >
        {t(lang, 'contact.copy')}
      </button>
    </div>
  </div>

  <form
    id="contact-form"
    class="rounded-3xl border border-line bg-surface p-6 sm:p-8"
    method="POST"
    action="https://formspree.io/f/xnnllzpo"
    data-success-msg={t(lang, 'contact.success')}
    data-error-msg={t(lang, 'contact.error')}
  >
    <!-- Honeypot: Formspree discards the submission if this field arrives filled (bots) -->
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

    <div class="flex flex-col gap-5">
      <div>
        <label class="mb-2 block text-sm font-medium text-ink-2" for="name">{t(lang, 'contact.name_label')}</label>
        <input type="text" id="name" name="name" required autocomplete="name" class={fieldClass} placeholder={t(lang, 'contact.name_placeholder')} />
      </div>

      <div>
        <label class="mb-2 block text-sm font-medium text-ink-2" for="email">{t(lang, 'contact.email_label')}</label>
        <input type="email" id="email" name="email" required autocomplete="email" class={fieldClass} placeholder={t(lang, 'contact.email_placeholder')} />
      </div>

      <div>
        <label class="mb-2 block text-sm font-medium text-ink-2" for="message">{t(lang, 'contact.message_label')}</label>
        <textarea id="message" name="message" rows="5" required class:list={[fieldClass, 'resize-y']} placeholder={t(lang, 'contact.message_placeholder')}></textarea>
      </div>

      <button
        type="submit"
        id="submit-btn"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-6 py-3.5 font-semibold text-on-accent transition-colors hover:bg-ink disabled:cursor-not-allowed disabled:opacity-60"
      >
        <span id="submit-text">{t(lang, 'contact.submit')}</span>
        <span id="submit-loading" class="hidden">{t(lang, 'contact.sending')}</span>
      </button>

      <p class="text-sm leading-relaxed text-muted">
        {t(lang, 'contact.privacy_notice')}
        <a href="/es/privacidad/" class="text-ink-2 underline underline-offset-2 hover:text-ink">{t(lang, 'contact.privacy_link')}</a>
      </p>

      <div id="form-message" class="hidden text-center" role="status"></div>
    </div>
  </form>
</div>

<script>
  import "../scripts/contact-form.ts";

  const copyButton = document.getElementById('copy-email');
  if (copyButton) {
    const original = copyButton.textContent;
    copyButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyButton.dataset.email ?? '');
        copyButton.textContent = copyButton.dataset.copied ?? original;
        setTimeout(() => {
          copyButton.textContent = original;
        }, 1800);
      } catch {
        // Clipboard unavailable: the address stays visible and selectable.
      }
    });
  }
</script>
