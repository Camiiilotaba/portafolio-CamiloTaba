---
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'
import type { Lang } from '../i18n/utils'
import { t, getLocalePath } from '../i18n/utils'
import '../styles/global.css'
import '../styles/header.css'

interface Props {
  lang?: Lang
  title?: string
  description?: string
  image?: string
  type?: string
}

const {
  lang = 'en' as Lang,
  title,
  description,
  image = '/og-image.jpg',
  type = 'website',
} = Astro.props

const pageTitle = title ?? t(lang, 'site.title')
const pageDescription = description ?? t(lang, 'site.description')
const siteUrl = Astro.site || 'https://camilotaba.dev'
const canonicalURL = new URL(Astro.url.pathname, siteUrl)
const ogImageURL = new URL(image, siteUrl)
const ogLocale = lang === 'es' ? 'es_ES' : 'en_US'
const enUrl = new URL(getLocalePath('en'), siteUrl)
const esUrl = new URL(getLocalePath('es'), siteUrl)

const jobTitle = lang === 'es' ? 'Desarrollador Web Fullstack' : 'Fullstack Web Developer'
const knowsAbout = lang === 'es'
  ? ['Desarrollo Web', 'JavaScript', 'TypeScript', 'React', 'Laravel', 'Astro', 'Tailwind CSS', 'Diseño UX/UI', 'Desarrollo Fullstack', 'APIs REST', 'WebSockets']
  : ['Web Development', 'JavaScript', 'TypeScript', 'React', 'Laravel', 'Astro', 'Tailwind CSS', 'UX/UI Design', 'Fullstack Development', 'REST APIs', 'WebSockets']

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Camilo Taba',
  jobTitle,
  url: siteUrl,
  image: ogImageURL.toString(),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Orihuela',
    addressRegion: 'Alicante',
    addressCountry: 'ES',
  },
  sameAs: [
    'https://github.com/Camiiilotaba',
    'https://www.linkedin.com/in/julian-camilo-blandon-taba-9b5210294/',
  ],
  knowsAbout,
  description: pageDescription,
  workLocation: [
    { '@type': 'Place', name: lang === 'es' ? 'Remoto' : 'Remote' },
    {
      '@type': 'Place',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Orihuela',
        addressRegion: 'Alicante',
        addressCountry: 'ES',
      },
    },
  ],
  areaServed: [
    { '@type': 'Country', name: lang === 'es' ? 'España' : 'Spain' },
    { '@type': 'AdministrativeArea', name: 'Comunidad Valenciana' },
    { '@type': 'AdministrativeArea', name: 'Región de Murcia' },
  ],
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Camilo Taba" />
    <meta name="generator" content={Astro.generator} />

    <!-- Hreflang for SEO -->
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Camilo Taba - Fullstack Developer" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Geo tags -->
    <meta name="geo.region" content="ES-VC" />
    <meta name="geo.placename" content="Orihuela, Alicante" />
    <meta name="geo.position" content="38.0858;-0.9429" />
    <meta name="ICBM" content="38.0858, -0.9429" />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>

  <body>
    <slot />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
