---
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'
import type { Lang } from '../i18n/utils'
import { t, getLocalePath } from '../i18n/utils'
import {
  getJobTitle,
  getKnowsAbout,
  getRemoteLabel,
  getCountryLabel,
  getRoleTitles,
  getOccupationDescription,
  getKnownLanguages,
} from '../data/seo'
import '../styles/global.css'
import '../styles/header.css'
import '../styles/scroll-driven.css'

interface Props {
  lang?: Lang
  title?: string
  description?: string
  image?: string
  type?: string
}

const {
  lang = 'en' as Lang,
  title,
  description,
  image = '/og-image.jpg',
  type = 'website',
} = Astro.props

const pageTitle = title ?? t(lang, 'site.title')
const pageDescription = description ?? t(lang, 'site.description')
const siteUrl = Astro.site || 'https://camilotaba.dev'
const canonicalURL = new URL(Astro.url.pathname, siteUrl)
const ogImageURL = new URL(image, siteUrl)
const ogLocale = lang === 'es' ? 'es_ES' : 'en_US'
const enUrl = new URL(getLocalePath('en'), siteUrl)
const esUrl = new URL(getLocalePath('es'), siteUrl)

const personId = `${siteUrl}#person`

const person = {
  '@type': 'Person',
  '@id': personId,
  name: 'Camilo Taba',
  alternateName: ['Julián Camilo Blandón Taba', ...getRoleTitles(lang)],
  jobTitle: getJobTitle(lang),
  url: siteUrl,
  image: ogImageURL.toString(),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Orihuela',
    addressRegion: 'Alicante',
    addressCountry: 'ES',
  },
  sameAs: [
    'https://github.com/Camiiilotaba',
    'https://www.linkedin.com/in/camilotaba/',
  ],
  knowsAbout: getKnowsAbout(lang),
  knowsLanguage: getKnownLanguages(lang),
  description: pageDescription,
  hasOccupation: {
    '@type': 'Occupation',
    name: getJobTitle(lang),
    description: getOccupationDescription(lang),
    occupationalCategory: getRoleTitles(lang),
    skills: getKnowsAbout(lang).join(', '),
    occupationLocation: { '@type': 'Country', name: getCountryLabel(lang) },
  },
  worksFor: {
    '@type': 'Organization',
    name: 'FleetX',
    url: 'https://fleetx.com/',
  },
  workLocation: [
    { '@type': 'Place', name: getRemoteLabel(lang) },
    {
      '@type': 'Place',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Orihuela',
        addressRegion: 'Alicante',
        addressCountry: 'ES',
      },
    },
  ],
  areaServed: [
    { '@type': 'Country', name: getCountryLabel(lang) },
    { '@type': 'AdministrativeArea', name: 'Comunidad Valenciana' },
    { '@type': 'AdministrativeArea', name: 'Región de Murcia' },
  ],
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'Camilo Taba',
      inLanguage: ogLocale,
      author: { '@id': personId },
      publisher: { '@id': personId },
    },
    {
      '@type': 'ProfilePage',
      url: canonicalURL.toString(),
      inLanguage: ogLocale,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { '@id': `${siteUrl}#website` },
      about: { '@id': personId },
      mainEntity: { '@id': personId },
    },
  ],
}

const metaKeywords = getKnowsAbout(lang).join(', ')
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={metaKeywords} />
    <meta name="author" content="Camilo Taba" />
    <meta name="generator" content={Astro.generator} />

    <!-- Hreflang for SEO -->
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Camilo Taba - Software Developer" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Geo tags -->
    <meta name="geo.region" content="ES-VC" />
    <meta name="geo.placename" content="Orihuela, Alicante" />
    <meta name="geo.position" content="38.0858;-0.9429" />
    <meta name="ICBM" content="38.0858, -0.9429" />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Fonts (async, non-render-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      />
    </noscript>
  </head>

  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a href="#home" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-green-500 focus:text-black focus:px-4 focus:py-2 focus:rounded-lg focus:font-semibold">
      Skip to main content
    </a>
    <slot />
    <Analytics />
    <SpeedInsights />
    <script>
      import "../scripts/scroll-animations.ts";
    </script>
  </body>
</html>
